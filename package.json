{
  "name": "chinese-conv",
  "description": "我就懶，無依賴的，簡繁轉換解決方案。very simple solution for lazy people, zero dependencies, converting simplified to traditional and traditional to simplified.",
  "version": "4.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./phrase": {
      "import": {
        "types": "./dist/phrase.d.ts",
        "default": "./dist/phrase.js"
      },
      "require": {
        "types": "./dist/phrase.d.cts",
        "default": "./dist/phrase.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-tongwen-dict"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "Traditional",
    "unicode",
    "Simplified",
    "conversion",
    "Chinese",
    "convert",
    "transform"
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "lefthook": "2.2.1",
    "publint": "0.3.25",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite build -w",
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts && cp dist/phrase.d.ts dist/phrase.d.cts",
    "tsc": "tsc --noEmit",
    "tsc:w": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:w": "vitest -w",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run test",
    "lint": "publint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqzhyi/chinese-conv.git"
  },
  "author": {
    "name": "ねむけ (Nemuke)",
    "email": "pleasurazy@gmail.com",
    "url": "https://github.com/aqzhyi"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aqzhyi/chinese-conv/issues"
  },
  "homepage": "https://github.com/aqzhyi/chinese-conv#readme",
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
